DATABASE_URL=postgresql://codegate:CHANGE-ME@postgres:5432/codegate
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# CHANGE THESE before any non-local deployment — they are the auth boundary
# of the pipeline (gateway API key + GitHub webhook HMAC secret).
GATEWAY_API_KEY=change-me
GITHUB_WEBHOOK_SECRET=change-me

# Generate values with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The password must match the password embedded in DATABASE_URL below.
POSTGRES_PASSWORD=CHANGE-ME

# Free online LLM provider (default). Get a free key at https://openrouter.ai
# — no card required. All model routes below default to ":free" models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional per-role model overrides (OpenRouter model ids):
# CODEGEN_MODEL=deepseek/deepseek-chat-v3-0324:free
# ESCALATION_MODEL=deepseek/deepseek-r1:free
# JUDGE_MODEL=google/gemini-2.0-flash-exp:free
# PLANNER_MODEL=meta-llama/llama-3.3-70b-instruct:free
